// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// parar criar migrate nova > npx prisma migrate dev
// npx prisma generate

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum OrderStatus {
  RECEBIDO
  PREPARANDO
  SAIU
  ENTREGUE
}

enum ComboGroupType {
  CATEGORY_CHOICE
  FIXED_PRODUCT
  PRODUCT_CHOICE
}

model Settings {
  id            String  @id @default(uuid())
  isStoreOpen   Boolean @default(true)
  minOrderValue Int     @default(1000) // em centavos, ex: 1000 = R$ 10,00

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id           String    @id @default(uuid())
  name         String
  displayOrder Int       @default(0)
  products     Product[]

  comboGroupCategories ComboGroupCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Product {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Int // em centavos (ex: 1000 = R$10)
  imageUrl    String?
  available   Boolean @default(true)
  stock       Int     @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  items OrderItem[]

  comboGroupFixedItems     ComboGroupFixedItem[]
  comboGroupChoiceProducts ComboGroupChoiceProduct[]
  comboItems               OrderComboItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model Order {
  id           String @id @default(uuid())
  customerName String
  phone        String
  address      String

  total       Int // em centavos
  deliveryFee Int @default(0)

  status OrderStatus @default(RECEBIDO)

  paymentMethod  String? // "dinheiro" | "debito" | "credito" | "pix" (validado no Zod, nao no schema)
  changeFor      Int? // troco em centavos, so quando paymentMethod = dinheiro
  noChangeNeeded Boolean @default(false)

  stockDeducted Boolean @default(false) // garante que o estoque baixe uma unica vez por pedido
  autoPrinted   Boolean @default(false) // evita reimprimir o mesmo pedido a cada polling do QZ Tray

  items OrderItem[]

  combos OrderCombo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id       String @id @default(uuid())
  quantity Int

  price Int // preço no momento da compra (IMPORTANTE)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_items")
}

model Combo {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Int
  imageUrl    String?
  available   Boolean @default(true)

  groups      ComboGroup[]
  orderCombos OrderCombo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("combos")
}

model ComboGroup {
  id      String @id @default(uuid())
  comboId String
  combo   Combo  @relation(fields: [comboId], references: [id], onDelete: Cascade)

  type  ComboGroupType
  label String

  categories     ComboGroupCategory[]
  fixedItems     ComboGroupFixedItem[]
  choiceProducts ComboGroupChoiceProduct[]

  minQuantity Int  @default(1)
  maxQuantity Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("combo_groups")
}

model ComboGroupCategory {
  id           String     @id @default(uuid())
  comboGroupId String
  comboGroup   ComboGroup @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@unique([comboGroupId, categoryId])
  @@map("combo_group_categories")
}

model ComboGroupFixedItem {
  id           String     @id @default(uuid())
  comboGroupId String
  comboGroup   ComboGroup @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int @default(1)

  @@unique([comboGroupId, productId])
  @@map("combo_group_fixed_items")
}

model ComboGroupChoiceProduct {
  id           String     @id @default(uuid())
  comboGroupId String
  comboGroup   ComboGroup @relation(fields: [comboGroupId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([comboGroupId, productId])
  @@map("combo_group_choice_products")
}

model OrderCombo {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  comboId String
  combo   Combo  @relation(fields: [comboId], references: [id])

  price Int

  items OrderComboItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_combos")
}

model OrderComboItem {
  id           String     @id @default(uuid())
  orderComboId String
  orderCombo   OrderCombo @relation(fields: [orderComboId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_combo_items")
}
